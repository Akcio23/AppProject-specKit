# API Configuration
# Em celular físico via Expo Go, substitua localhost pelo IP da sua máquina na rede local (ex: http://192.168.0.10:3000/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_ENVIRONMENT=development

# bible-api.com (SPEC 002)
EXPO_PUBLIC_BIBLE_API_URL=https://bible-api.com
